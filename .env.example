# Kinwatch environment
# Copy to .env and fill values. Never commit .env.

KINWATCH_HOST=0.0.0.0
KINWATCH_PORT=8000
KINWATCH_PUBLIC_BASE_URL=http://127.0.0.1:8000
KINWATCH_DATA_DIR=./data
KINWATCH_HOUSEHOLD_TZ=America/Los_Angeles

# Fixture Playground mode (default). Set false when a live Ring token is present.
KINWATCH_USE_FIXTURES=true

# Ring Partner API (amazonvision). Never commit tokens.
RING_API_BASE=https://api.amazonvision.com
RING_OAUTH_TOKEN_URL=https://oauth.ring.com/oauth/token
RING_ACCESS_TOKEN=
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=
RING_HMAC_KEY=
RING_AUDIO_REF=

# AWS (Bedrock vision, Polly/Nova speech, DynamoDB memory)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
KINWATCH_BEDROCK_VISION_MODEL=amazon.nova-lite-v1:0
KINWATCH_BEDROCK_SPEECH_MODEL=amazon.nova-sonic-v1:0
KINWATCH_POLLY_VOICE=Joanna
KINWATCH_DDB_TABLE=

# Optional Strands model id when the AWS extra is installed
KINWATCH_STRANDS_MODEL=amazon.nova-pro-v1:0
